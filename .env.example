# Клиент Vite (подставляются значения из вывода `supabase status`)
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=

# Google OAuth — для supabase/config.toml [auth.external.google].
# Клиент создаётся в Google Cloud Console, тип «Web application».
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
